FROM php:8.2-cli-alpine

RUN apk add --no-cache \
    sqlite-dev \
    curl-dev \
    libxml2-dev \
    oniguruma-dev \
    git \
    unzip \
    bash

RUN docker-php-ext-install \
    pdo_sqlite \
    curl \
    mbstring \
    xml \
    bcmath

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY backend/composer.* ./
RUN composer install --no-interaction --no-scripts --prefer-dist

COPY backend ./
COPY docker/entrypoint-backend.sh /usr/local/bin/entrypoint-backend.sh
RUN chmod +x /usr/local/bin/entrypoint-backend.sh

RUN mkdir -p database storage/framework/sessions storage/framework/views storage/framework/cache storage/logs && \
    touch database/database.sqlite && \
    composer run-script post-autoload-dump

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/entrypoint-backend.sh"]
